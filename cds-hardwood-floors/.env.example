# Public, build-time environment variables. Copy to `.env.local`.
# These are safe to expose to the browser (NEXT_PUBLIC_*) or are non-secret.

# Canonical site origin (no trailing slash). Used for metadata, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://cdshardwoodfloors.com

# Cloudflare Turnstile public site key (managed widget).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
